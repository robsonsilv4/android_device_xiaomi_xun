# MMC queue tuning nodes touched by init.qcom.post_boot.sh and init.rc.
# The bengal policy labels mmcblk0/queue/read_ahead_kb only; the same SoC
# policy for trinket labels the BDI node and the two boot partitions, and the
# SD controller node is missing from both. Without these the writes are denied
# and the tuning silently does not happen.
genfscon sysfs /devices/virtual/bdi                                                                   u:object_r:vendor_sysfs_mmc_host:s0
genfscon sysfs /devices/platform/soc/4744000.sdhci/mmc_host/mmc0/mmc0:0001/block/mmcblk0/mmcblk0boot0/queue/read_ahead_kb    u:object_r:vendor_sysfs_mmc_host:s0
