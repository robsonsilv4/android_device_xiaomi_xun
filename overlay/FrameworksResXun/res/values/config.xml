<!-- These resources are around just to allow their values to be customized
     for different hardware and product builds.  Do not translate. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Indicate whether closing the lid causes the device to go to sleep and opening
         it causes the device to wake up.
         The default is false. -->
    <bool name="config_lidControlsSleep">true</bool>

    <!-- The default refresh rate for a given device. Change this value to set a higher default
         refresh rate. If the hardware composer on the device supports display modes with a higher
         refresh rate than the default value specified here, the framework may use those higher
         refresh rate modes if an app chooses one by setting preferredDisplayModeId or calling
         setFrameRate().
         If a non-zero value is set for config_defaultPeakRefreshRate, then
         config_defaultRefreshRate may be set to 0, in which case the value set for
         config_defaultPeakRefreshRate will act as the default frame rate. -->
    <integer name="config_defaultPeakRefreshRate">90</integer>

    <!-- Enable lockscreen rotation by default -->
    <bool name="config_enableLockScreenRotation">true</bool>

    <!-- If true, the screen can be rotated via the accelerometer in all 4
         rotations as the default behavior. -->
    <bool name="config_allowAllRotations">true</bool>

    <!-- Enable automatic brightness. The framework default is false and this
         product does not inherit the sm6225-common overlay that raises it.
         See docs/decisions/0003-enable-auto-brightness.md. -->
    <bool name="config_automatic_brightness_available">true</bool>

    <!-- Auto-brightness curve. The framework arrays are empty and must be
         overridden per device; with them empty no BrightnessMappingStrategy is
         created and the light sensor is never subscribed. The lux levels and
         the matching backlight values are the first cut, tunable on the
         device. See docs/decisions/0003-enable-auto-brightness.md. -->
    <integer-array name="config_autoBrightnessLevels">
        <item>1</item>
        <item>4</item>
        <item>10</item>
        <item>40</item>
        <item>100</item>
        <item>325</item>
        <item>600</item>
        <item>1200</item>
        <item>2400</item>
        <item>6000</item>
    </integer-array>
    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>8</item>
        <item>15</item>
        <item>25</item>
        <item>40</item>
        <item>60</item>
        <item>85</item>
        <item>115</item>
        <item>150</item>
        <item>190</item>
        <item>225</item>
        <item>255</item>
    </integer-array>
</resources>
